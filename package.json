{
  "name": "claude-contextus",
  "version": "0.19.7",
  "description": "Context-aware knowledge system: markdown-based pattern storage with automatic semantic retrieval for Claude Code",
  "main": "dist/scripts/query-hook.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "embed": "tsx scripts/embed-contexts.ts",
    "rebuild": "tsx scripts/embed-contexts.ts --rebuild",
    "fetch-model": "tsx scripts/fetch-model.ts",
    "daemon": "tsx daemon/server.ts",
    "eval-worker": "tsx daemon/eval-worker.ts",
    "calibrate-floor": "tsx scripts/calibrate-floor.ts",
    "query": "tsx scripts/search.ts",
    "dev": "tsc --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:all": "node --import tsx --test tests/*.test.ts tests/integration/*.test.ts",
    "test:types": "tsc --noEmit",
    "migrate-memory": "tsx scripts/migrate-memory.ts",
    "contextus-setup": "tsx scripts/contextus-setup.ts",
    "tag-context": "tsx scripts/tag-context.ts",
    "calibrate": "tsx scripts/context-calibrate.ts",
    "usage-rate": "tsx scripts/usage-rate.ts",
    "cost-report": "tsx scripts/cost-report.ts",
    "setup-detect": "tsx scripts/setup-detect.ts",
    "link-project": "tsx scripts/link-project.ts",
    "unlink-project": "tsx scripts/link-project.ts --remove",
    "upgrade-detect": "tsx scripts/upgrade-detect.ts",
    "migrate-workspaces": "tsx scripts/migrate-workspaces.ts",
    "mine-transcripts": "tsx scripts/mine-transcripts.ts",
    "check-release": "tsx scripts/check-release.ts",
    "lint": "eslint lib scripts daemon --ext .ts",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "claude",
    "memory",
    "context",
    "rag",
    "semantic-search",
    "embeddings",
    "lancedb",
    "claude-code"
  ],
  "author": "Anthony Dawson",
  "repository": {
    "type": "git",
    "url": "https://github.com/equiphealth/claude-contextus.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1070.0",
    "@lancedb/lancedb": "^0.30.0",
    "@xenova/transformers": "^2.17.0",
    "glob": "^10.3.10",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.2.5",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  }
}
