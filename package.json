{
  "name": "claude-contextus",
  "version": "0.1.0",
  "description": "Context-aware knowledge system: markdown-based pattern storage with automatic semantic retrieval for Claude Code",
  "main": "dist/scripts/query-hook.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "embed": "tsx scripts/embed-contexts.ts",
    "rebuild": "tsx scripts/embed-contexts.ts --rebuild",
    "fetch-model": "tsx scripts/fetch-model.ts",
    "daemon": "tsx daemon/server.ts",
    "query": "tsx scripts/search.ts",
    "dev": "tsc --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:types": "tsc --noEmit",
    "migrate-memory": "tsx scripts/migrate-memory.ts",
    "lint": "eslint lib scripts daemon --ext .ts",
    "format": "prettier --write \"lib/**/*.ts\" \"scripts/**/*.ts\" \"daemon/**/*.ts\" \"*.json\"",
    "format:all": "prettier --write \"**/*.{ts,json}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "memory",
    "context",
    "rag",
    "semantic-search",
    "embeddings",
    "chroma",
    "claude-code"
  ],
  "author": "Anthony Dawson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/claude-contextus.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@xenova/transformers": "^2.17.0",
    "glob": "^10.3.10",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.2.5",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  }
}
