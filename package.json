{
  "name": "claude-contextus",
  "version": "0.1.0",
  "description": "Context-aware knowledge system: markdown-based pattern storage with automatic semantic retrieval for Claude Code",
  "main": "dist/scripts/query-hook.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "embed": "npm run build && node dist/scripts/embed-contexts.js",
    "rebuild": "npm run build && node dist/scripts/embed-contexts.js --rebuild",
    "query": "npm run build && node dist/scripts/query-hook.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "memory",
    "context",
    "rag",
    "semantic-search",
    "embeddings",
    "chroma",
    "claude-code"
  ],
  "author": "Anthony Dawson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/claude-contextus.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chromadb": "^1.8.1",
    "@xenova/transformers": "^2.17.0",
    "gray-matter": "^4.0.3",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
