{
  // RUNTIME CONFIG, not the plugin manifest. The code reads this file's `config` block
  // via findPluginJson() (config.ts). The Claude Code plugin MANIFEST is
  // .claude-plugin/plugin.json (name: 'contextus' — the marketplace install id).
  // Two files on purpose: this is the tunable runtime config, that is the install descriptor.
  // Keep `version` in sync with the manifest.
  "name": "contextus",
  "version": "0.20.0",
  "description": "Context-aware knowledge system with automatic semantic retrieval",
  "author": "Anthony Dawson",
  "repository": "github:equiphealth/claude-contextus",
  "engines": {
    "claude": ">=1.0.0",
    "node": ">=22.0.0"
  },
  "config": {
    "enabled": true,
    "providers": {
      "ollama": {
        "endpoint": "http://localhost:11434"
      },
      "bedrock": {
        "region": "us-east-1"
      },
      "anthropic": {}
      // Meta Model API (Muse support). Uncomment to use; key comes from the
      // named env var at call time, never baked in here.
      // "meta": {
      //   "endpoint": "https://api.meta.ai/v1",
      //   "apiKeyEnv": "META_API_KEY"
      // }
      // MODEL_API_KEY is honored as a fallback when apiKeyEnv is unset.
    },
    "sources": {
      "projectContext": {
        "type": "context",
        "scope": "project",
        "path": ".claude/context",
        "enabled": true,
        "indexFile": "CONTEXT.md",
        // .archive/** holds files moved out of the corpus by /delete or /context-archive
        "exclude": ["**/CONTEXT.md", "**/README.md", "**/.archive/**"]
      },
      "projectDocs": {
        "type": "doc",
        "scope": "project",
        "path": "docs",
        "enabled": true,
        "indexFile": "DOCS.md",
        "exclude": ["**/DOCS.md", "**/README.md"]
      },
      "userContext": {
        "type": "context",
        "scope": "user",
        "path": "~/.contextus/context",
        "enabled": true,
        "indexFile": "CONTEXT.md",
        "exclude": ["**/CONTEXT.md", "**/README.md", "**/.archive/**"]
      },
      "userDocs": {
        "type": "doc",
        "scope": "user",
        "path": "~/.contextus/docs",
        "enabled": true,
        "indexFile": "DOCS.md",
        "exclude": ["**/DOCS.md", "**/README.md"]
      }
    },
    "lancedb": {
      "mode": "file",
      "path": "~/.contextus/data/{project-name}"
    },
    "embedding": {
      // DESIGN.md default is 'transformers' (in-process ONNX). Deployed as 'ollama'
      // because the corporate Cloudflare Gateway blocks Hugging Face model downloads —
      // Ollama runs the same nomic model locally over localhost.
      "provider": "ollama",
      "model": "nomic-ai/nomic-embed-text-v1.5",
      "ollamaModel": "nomic-embed-text",
      "dimensions": 768,
      "batchSize": 32,
      "transformers": {
        // Used when provider='transformers'. To run on an HF-blocked network:
        // `pnpm fetch-model --out ./models` on an unblocked machine, then set
        // localModelPath to that dir. Or set remoteHost to an internal HF mirror.
        "localModelPath": "",
        "cacheDir": "",
        "remoteHost": "https://huggingface.co/",
        "allowRemoteModels": true
      }
    },
    "retrieval": {
      "topK": 5,
      "similarityThreshold": 0.7, // Post-ranking filter — calibrate in Phase 5
      // Gate on raw similarity — 'inject anything at all?'. SEPARATE from similarityThreshold.
      // Calibrated to 0.45 via /context-calibrate --floor against 721-chunk corpus.
      "injectionFloor": 0.725,
      "maxTokens": 3000,
      "mergeStrategy": "interleaved",
      // Hybrid search: fuse keyword (BM25) + semantic (vector) via Reciprocal Rank Fusion.
      // adaptive=keyword augments only when semantic scores are below floor (rescues exact-symbol queries).
      // always=every query gets both. off=pure semantic (keyword only as error fallback).
      "hybrid": "adaptive"
    },
    "expansion": {
      // Multi-vector query expansion: generate alternate phrasings when the initial
      // search scores poorly. adaptive=expand only below threshold, always=every query.
      "mode": "adaptive",
      "provider": "ollama",
      "model": "qwen2.5:3b",
      "fallbackProvider": "bedrock",
      "fallbackModel": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      "expansionThreshold": 0.775,
      "maxVariants": 3,
      "temperature": 0.7,
      "timeoutMs": 5000
      // Meta example (Spark 1.3 Contributor — verified live; reasoning models
      // need headroom, so raise the timeout or expansion silently falls back):
      // "provider": "meta",
      // "model": "muse-spark-1.3-contributor",
      // "timeoutMs": 25000
    },
    "autoRebuild": true,
    "contextCapture": {
      "enabled": true,
      "mode": "staging",
      // "always" = emit "Context: captured [scope]:" for every capture
      // "off" = no capture confirmation in response
      "captureFooter": "always",
      // PROTOTYPE (default off): Stop-hook enforcement gate. When true, a
      // `git commit` with no capture logged since blocks turn completion once,
      // asking for a /capture call or an explicit "Context: capture-skip: <why>".
      // See decisions/decision-capture-enforcement-needs-a-stop-hook-not-wording.md
      "stopGate": false
    },
    "calibration": {
      // Quality evaluation (LOGGING.md calibration_eval). Provider judges whether
      // injected patterns were USED (bedrock Haiku — proven reliable, uses AWS creds).
      // MUTABLE campaign state lives in ~/.contextus/calibration-state.json, NOT here.
      "targetSamples": 100,
      "provider": "bedrock",
      "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
    },
    "notifications": {
      // SessionStart daemon-state messages (user-facing systemMessage).
      // silent=never | normal=fresh spawn/warming/failure | verbose=also heartbeat
      "verbosity": "verbose"
    },
    "logging": {
      // Logs full prompt + injection to ~/.contextus/logs/paranoid.jsonl.
      // OFF by default (privacy). View with: contextus watch --paranoid
      "paranoid": true
    },
    "capacityProtection": {
      // Token overflow prevention (GitHub #17). The statusline script writes
      // context_window stats; the query hook passes them to the daemon. When the
      // conversation is near the model's context limit, injection is reduced or disabled.
      "enabled": true,
      // Percentage thresholds for graduated degradation:
      "reduceAt": 70, // reduce topK to min(configured, 3)
      "minimalAt": 80, // topK=1, floor*1.2
      "disableAt": 85 // no injection, emit warning
      // Optional explicit context-window size (tokens). Hosts that report
      // cumulative input_tokens without a used_percentage (Muse PostLLMCall
      // accumulator) resolve pct = input_tokens / contextWindowTokens * 100.
      // Unset = percentage path only; the daemon never guesses a window.
      // "contextWindowTokens": 200000
    },
    "usageEvaluation": {
      // Evaluate injected context usage after each response. Runs in a background loop
      // (never blocks prompts). Logs to ~/.contextus/data/<projectId>/usage-ratings.jsonl
      // for Phase 2 analytics (context-stats, context-review, context-doctor).
      "enabled": true,
      // 'continuous' = always-on, 'campaign' = bounded sample then auto-stop (for testing)
      "mode": "continuous",
      // Provider + model for evaluation (same registry as calibration). Bedrock Haiku
      // default: cheapest, reliable, proven in calibration tests.
      "provider": "bedrock",
      "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      // Fraction of injections to evaluate (0.0-1.0). Reduce if cost is a concern.
      "samplingRate": 1.0,
      "staleness": {
        // Days of non-retrieval before a pattern is considered stale. Default: 180.
        "windowDays": 180,
        // Avg score threshold below which a pattern is considered noisy. Default: 0.3.
        "noiseThreshold": 0.3,
        // Min evaluations required before a pattern can be flagged as noisy. Default: 10.
        "minEvals": 10
      }
    },
    "transcriptMining": {
      // Retrospective safety net (GH issue #39) — mines past Claude Code session
      // logs for patterns live capture missed. Off by default: real LLM cost/time
      // per session window, shouldn't run without explicit opt-in. /contextus-setup
      // asks and writes this per-project.
      "enabled": false,
      // Minimum hours between SessionStart-triggered scans, even when enabled —
      // SessionStart can fire many times a day; this isn't one of them.
      "intervalHours": 24
    }
  },
  "hooks": "hooks/hooks.json",
  "skills": [
    // Core actions
    "skills/configure",
    "skills/create-context",
    "skills/create-doc",
    "skills/update-context",
    "skills/add-patterns",
    "skills/rebuild-embeddings",
    "skills/migrate-memory",
    "skills/link-project",
    "skills/manage-daemon",
    "skills/mine-transcripts",

    // Context operations (corpus)
    "skills/context-search",
    "skills/context-status",
    "skills/context-stats",
    "skills/context-doctor",
    "skills/context-review",
    "skills/context-calibrate",
    "skills/context-archive",
    "skills/context-merge",
    "skills/context-tag",
    "skills/context-audit",

    // Contextus operations (system)
    "skills/contextus-setup",
    "skills/contextus-upgrade",
    "skills/contextus-watch",

    // Unified shortcut dispatcher — replaced the individual ctx-* alias
    // skills (0.14.0's own changelog says 8 were replaced; this array had
    // grown to 14 dead ctx-* entries by the time this was fixed, presumably
    // from aliases added after 0.14.0). Those directories no longer exist;
    // this entry used to be missing here even after the replacement, so the
    // registry referenced 14 dead paths and omitted the one that actually
    // exists.
    "skills/ctx"
  ]
}
