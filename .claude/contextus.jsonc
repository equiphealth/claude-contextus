{
  // Project-level contextus config override (tier 3, highest precedence).
  // See docs/dev/DESIGN.md for the 3-tier merge:
  //   global plugin.json → ~/.contextus/config.json → ./.claude/contextus.jsonc
  "providers": {
    // Shared connection settings — referenced by all features (embedding, expansion, calibration)
    "ollama": {
      "endpoint": "http://localhost:11434"
    },
    "bedrock": {
      "region": "us-east-1"
    },
    "anthropic": {}
  },
  // No "embedding" block here, deliberately (removed 2026-11-01 — was
  // "ollama" and caused a live model-id mismatch). There is no per-project
  // embedding override at ANY tier — lib/embedding/embedder.ts reads ONLY
  // plugin.jsonc's global default (one daemon process, one loaded model,
  // shared by every project on this machine). A write here, or in
  // ~/.contextus/data/contextus/config.json (tier 2), would be silently
  // ignored by the actual embed call — worse than an error. See
  // gotchas/gotcha-embedding-provider-switch.md. plugin.jsonc's shipped
  // default (transformers) already matches what this machine's corpus is
  // actually embedded with. If a future machine genuinely needs to differ,
  // that's a machine-wide migration — edit plugin.jsonc itself, restart the
  // daemon, and /rebuild-embeddings --full everywhere — never a project file.
  "lancedb": {
    "mode": "file",
    "path": "~/.contextus/data/{project-name}"
  },
  "retrieval": {
    "topK": 5,
    "similarityThreshold": 0.7,
    "injectionFloor": 0.7,
    "maxTokens": 3000,
    "mergeStrategy": "interleaved",
    "provenanceFooter": true
  },
  "expansion": {
    // Multi-vector query expansion: generates alternate phrasings when initial search
    // scores poorly. Dramatically improves synonym/paraphrase recall.
    "mode": "adaptive", // adaptive (default) | always (every query) | off
    "provider": "ollama", // ollama (local, fast) | bedrock (AWS) | anthropic (direct API)
    "model": "qwen2.5:3b", // Small/fast recommended for ollama
    "fallbackProvider": "bedrock",
    "fallbackModel": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    // Fallback fires only on fast failures (connection refused) with remaining time budget
    "expansionThreshold": 0.7, // Adaptive mode fires when best initial score < this — must be >= retrieval.injectionFloor (0.7) to avoid a dead zone; was 0.775 (fired on queries that already cleared the floor, pure waste with no rescue possible)
    "maxVariants": 3, // Alternative phrasings (2-5 recommended)
    "temperature": 0.7, // Higher = more diverse rephrasings
    "timeoutMs": 5000 // Total expansion budget in ms (shared primary + fallback)
  },
  "autoRebuild": true,
  "contextCapture": {
    "enabled": true,
    "mode": "staging",
    "captureFooter": "always",
    // Dogfooding the prototype (decision-capture-enforcement-needs-a-stop-hook-not-wording.md):
    // blocks turn completion once if a git commit ran with no /capture logged since.
    "stopGate": true
  },
  "calibration": {
    "targetSamples": 100,
    "provider": "bedrock",
    "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
  },
  "notifications": {
    "verbosity": "verbose"
  },
  "logging": {
    "paranoid": true,
    "retention": {
      "activeDays": 30,
      "archiveMonths": 6,
      "paranoidDays": 7
    }
  }
}
