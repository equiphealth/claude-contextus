{
  // Project-level contextus config override (tier 3, highest precedence).
  // See docs/dev/DESIGN.md for the 3-tier merge:
  //   global plugin.json → ~/.contextus/config.json → ./.claude/contextus.jsonc
  "providers": {
    // Shared connection settings — referenced by all features (embedding, expansion, calibration)
    "ollama": {
      "endpoint": "http://localhost:11434"
    },
    "bedrock": {
      "region": "us-east-1"
    },
    "anthropic": {}
  },
  "embedding": {
    "provider": "ollama",
    "model": "nomic-ai/nomic-embed-text-v1.5",
    "ollamaModel": "nomic-embed-text",
    "dimensions": 768,
    "batchSize": 32,
    "transformers": {
      "localModelPath": "",
      "cacheDir": "",
      "remoteHost": "https://huggingface.co/",
      "allowRemoteModels": true
    }
  },
  "lancedb": {
    "mode": "file",
    "path": "~/.contextus/data/{project-name}"
  },
  "retrieval": {
    "topK": 5,
    "similarityThreshold": 0.7,
    "injectionFloor": 0.725,
    "maxTokens": 3000,
    "mergeStrategy": "interleaved",
    "provenanceFooter": true
  },
  "expansion": {
    // Multi-vector query expansion: generates alternate phrasings when initial search
    // scores poorly. Dramatically improves synonym/paraphrase recall.
    "mode": "adaptive", // adaptive (default) | always (every query) | off
    "provider": "ollama", // ollama (local, fast) | bedrock (AWS) | anthropic (direct API)
    "model": "qwen2.5:3b", // Small/fast recommended for ollama
    "fallbackProvider": "bedrock",
    "fallbackModel": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    // Fallback fires only on fast failures (connection refused) with remaining time budget
    "expansionThreshold": 0.775, // Adaptive mode fires when best initial score < this
    "maxVariants": 3, // Alternative phrasings (2-5 recommended)
    "temperature": 0.7, // Higher = more diverse rephrasings
    "timeoutMs": 5000 // Total expansion budget in ms (shared primary + fallback)
  },
  "autoRebuild": true,
  "contextCapture": {
    "enabled": true,
    "mode": "staging"
  },
  "calibration": {
    "targetSamples": 100,
    "provider": "bedrock",
    "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
  },
  "notifications": {
    "verbosity": "verbose"
  },
  "logging": {
    "paranoid": true,
    "retention": {
      "activeDays": 30,
      "archiveMonths": 6,
      "paranoidDays": 7
    }
  }
}
