{
  "hooks": {
    "SessionStart": [
      {
        "id": "contextus-session-start",
        "event": "SessionStart",
        "command": ["node", "adapter/muse-code/session-start.js"],
        "timeoutMs": 15000,
        "statusMessage": "Contextus: warming daemon"
      }
    ],
    "UserPromptSubmit": [
      {
        "id": "contextus-query",
        "event": "UserPromptSubmit",
        "command": ["node", "adapter/muse-code/query.js"],
        "timeoutMs": 10000,
        "statusMessage": "Contextus: retrieving context"
      }
    ],
    "PostToolUse": [
      {
        "id": "contextus-watch",
        "event": "PostToolUse",
        "command": ["node", "adapter/muse-code/watch.js"],
        "timeoutMs": 5000,
        "statusMessage": "Contextus: tracking context edits"
      }
    ],
    "Stop": [
      {
        "id": "contextus-stop",
        "event": "Stop",
        "command": ["node", "adapter/muse-code/stop.js"],
        "timeoutMs": 5000,
        "statusMessage": "Contextus: logging usage"
      }
    ]
  }
}
