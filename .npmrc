# Allow native module builds (@lancedb / @xenova bindings)
enable-pre-post-scripts=true
# Fail loudly on a mismatched Node instead of erroring cryptically at runtime.
# The repo needs Node 22 (see .nvmrc); a wrong-Node install should say so.
engine-strict=true
# Pin the public registry: this repo has no private dependencies, and a
# work-proxy registry (e.g. CodeArtifact via ~/.npmrc) breaks `pnpm install`
# for contributors who haven't authenticated to it.
registry=https://registry.npmjs.org/
