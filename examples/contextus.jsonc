{
  // Sample .claude/contextus.jsonc — copy to your project's .claude/ directory and edit.
  // This is tier 3 (highest precedence): overrides plugin.json defaults and
  // ~/.contextus/data/<project>/config.json. Only include keys you want to override.

  "providers": {
    // Shared connection settings. All features (embedding, expansion, calibration)
    // reference these instead of duplicating endpoints.
    "ollama": {
      "endpoint": "http://localhost:11434" // Ollama HTTP API. Change if different port or remote host.
    },
    "bedrock": {
      "region": "us-east-1" // AWS region for InvokeModel. Uses default credential chain.
    },
    "anthropic": {} // Direct Anthropic API. Requires ANTHROPIC_API_KEY env var.
  },

  // DON'T actually put "embedding" in YOUR .claude/contextus.jsonc, OR in
  // ~/.contextus/data/<project>/config.json — shown here for the field
  // shapes only. lib/embedding/embedder.ts reads ONLY plugin.jsonc's global
  // default; there is no per-project override at any tier, so a write here
  // would be silently ignored by the actual embed call (worse than an
  // error — /configure show would then lie about what's really active).
  // Caught live (2026-11-01): a stale project override caused a model-id
  // mismatch exactly this way on contextus's own dogfood project — see
  // gotchas/gotcha-embedding-provider-switch.md. If your machine genuinely
  // needs to differ from plugin.jsonc's shipped default, that's a
  // machine-wide migration — edit plugin.jsonc directly, restart the
  // daemon, then /rebuild-embeddings --full for every project + user scope.
  "embedding": {
    // Vector embedding for semantic search. The provider that BUILT the corpus must
    // match at query time — switching requires a full re-embed.
    // FIELD SHAPES ONLY — this whole object is commented out on purpose.
    // (Uncomment to use as a template, but do NOT activate it here: the
    // embedder ignores project-level embedding config.)
    // "provider": "ollama", // ollama | transformers (in-process ONNX)
    // "model": "nomic-ai/nomic-embed-text-v1.5", // HuggingFace model ID (transformers provider)
    // "ollamaModel": "nomic-embed-text", // Ollama model tag. Pull first: `ollama pull nomic-embed-text`
    // "dimensions": 768, // Must match model output dimensions
    // "batchSize": 32, // Chunks per batch. Higher = faster, more memory.
    // "transformers": {
    //   // Only used when provider='transformers'. Ignored for ollama.
    //   "localModelPath": "", // Pre-downloaded model dir (air-gapped installs)
    //   "cacheDir": "", // Override transformers.js cache dir
    //   "remoteHost": "https://huggingface.co/", // Point at internal mirror if HF is blocked
    //   "allowRemoteModels": true // Set false for strict offline
    // }
  },

  "sources": {
    // What gets embedded into the corpus. Each of these four is independently
    // toggleable — disable one without touching the others. Keys beyond these
    // four are supported too (same shape); add one for e.g. a second docs tree.
    // Linked projects (via /link-project) are NOT configured here — that's a
    // separate workspace-registry mechanism, not a `sources` entry.
    "projectContext": {
      "type": "context", // 'context' | 'doc' — feeds re-ranking's typeBoost/sourceWeight
      "scope": "project", // 'project' | 'user' — user-scope is shared across all projects
      "path": ".claude/context",
      "enabled": true,
      "indexFile": "CONTEXT.md", // Auto-maintained index; excluded from embedding itself
      "exclude": ["**/CONTEXT.md", "**/README.md", "**/.archive/**"]
    },
    "projectDocs": {
      "type": "doc",
      "scope": "project",
      "path": "docs",
      "enabled": true,
      "indexFile": "DOCS.md",
      "exclude": ["**/DOCS.md", "**/README.md"]
    },
    "userContext": {
      "type": "context",
      "scope": "user", // Cross-project corpus at ~/.contextus/context, ranked below project-scoped
      "path": "~/.contextus/context",
      "enabled": true,
      "indexFile": "CONTEXT.md",
      "exclude": ["**/CONTEXT.md", "**/README.md", "**/.archive/**"]
    },
    "userDocs": {
      "type": "doc",
      "scope": "user",
      "path": "~/.contextus/docs",
      "enabled": true,
      "indexFile": "DOCS.md",
      "exclude": ["**/DOCS.md", "**/README.md"]
    }
  },

  "retrieval": {
    // Controls what gets injected into Claude's context.
    "topK": 5, // Max context files per prompt (after dedup + floor)
    "similarityThreshold": 0.7, // Post-ranking quality filter (NOT the injection gate)
    "injectionFloor": 0.45, // Raw similarity gate: 'inject anything at all?'
    "maxTokens": 3000, // Token budget for injected context (approximate)
    "mergeStrategy": "interleaved", // interleaved | prioritize-context | prioritize-docs
    "provenanceFooter": true, // Show 'Context: used: <file> (<score>)' footer
    "hybrid": "always" // always=fuse keyword+semantic via RRF | off=pure semantic
  },

  "expansion": {
    // Multi-vector query expansion: generates alternate phrasings when initial search
    // scores poorly. Dramatically improves synonym/paraphrase recall.
    "mode": "adaptive", // adaptive (expand when score < threshold) | always | off
    "provider": "ollama", // ollama | bedrock | anthropic
    "model": "qwen2.5:3b", // Primary provider model. Small/fast recommended for ollama.
    "fallbackProvider": "bedrock",
    "fallbackModel": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    // Fallback fires only on FAST failures (connection refused, DNS) with remaining
    // time budget. Slow timeouts do NOT fall back.
    "expansionThreshold": 0.55, // Adaptive fires when best initial score < this (0.0-1.0)
    "maxVariants": 3, // Alternative phrasings to generate (2-5 recommended)
    "temperature": 0.7, // LLM temperature (0.0-2.0). Higher = more diverse.
    "timeoutMs": 5000 // Total expansion time budget (shared primary + fallback)
  },

  "calibration": {
    // Quality evaluation: judges whether injected patterns were actually USED by Claude.
    // Runs as a bounded campaign (N samples, then auto-disables).
    "targetSamples": 100, // Evaluations per campaign. Start with /context-calibrate --start.
    "provider": "bedrock", // bedrock | anthropic | ollama
    "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0" // Judge model. Haiku recommended.
  },

  "contextCapture": {
    // Pattern proposal system — how contextus suggests new patterns to capture.
    "enabled": true,
    "mode": "propose", // propose (suggest) | staging (write directly, git is gate) | silent
    "captureFooter": "always", // "always" = emit "Context: captured [scope]:" | "off" = no confirmation
    // PROTOTYPE, default false: Stop-hook enforcement. When true, a `git commit`
    // with no capture logged since blocks turn completion once, asking for a
    // /capture call or an explicit "Context: capture-skip: <why>". Logs the
    // outcome (nudged / captured-after-nudge / missed) to
    // ~/.contextus/logs/capture-nudges.jsonl and daemon.log either way.
    "stopGate": false
  },

  "notifications": {
    // SessionStart daemon-state messages (user-facing).
    "verbosity": "normal" // silent | normal (spawn/failure only) | verbose (also heartbeat)
  },

  "logging": {
    // Daemon logging. All logs write to ~/.contextus/logs/.
    "paranoid": false, // Log full prompt + injection payload. Privacy-sensitive. Good for debugging.
    "retention": {
      "activeDays": 30, // Days before standard logs rotate to archive/
      "archiveMonths": 6, // Months before archived .gz files are deleted
      "paranoidDays": 7 // Days before paranoid.jsonl is DELETED (privacy, not archived)
    }
  },

  "capacityProtection": {
    // Token overflow prevention: reads context-window stats from statusline bridge
    // and reduces/disables injection as conversation approaches model limit.
    // Requires statusline bridge (installed by /contextus-setup or /contextus-upgrade).
    "enabled": true, // Set false to disable capacity-aware throttling
    "reduceAt": 70, // % capacity to start reducing topK (to min(configured, 3))
    "minimalAt": 80, // % capacity for minimal injection (topK=1, floor*1.2)
    "disableAt": 85 // % capacity to disable injection entirely (emit warning only)
  },

  "usageEvaluation": {
    // Continuous usage feedback: evaluates every injected context to learn what's actually
    // useful. Runs in background (never blocks prompts). Powers /context-stats, /context-review,
    // and /context-doctor analytics. Default: always-on. Disable for privacy or cost reasons.
    "enabled": true,
    "mode": "continuous", // continuous (always-on) | campaign (bounded N samples, then stop)
    "provider": "bedrock", // bedrock | anthropic | ollama
    "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0", // Eval model. Haiku recommended (~$0.001/query).
    "samplingRate": 1.0, // Fraction of injections to evaluate (0.0-1.0). Reduce to cut costs.
    "staleness": {
      // Thresholds for /context-doctor health checks.
      "windowDays": 180, // Days of non-retrieval before pattern is "stale"
      "noiseThreshold": 0.3, // Avg score below this = "noisy" pattern
      "minEvals": 10 // Min evaluations before flagging as noisy
    }
  },

  "transcriptMining": {
    // Retrospective safety net: mines past Claude Code session logs for patterns
    // live capture missed (GH issue #39). Off by default — real LLM cost/time per
    // session window, shouldn't run without explicit opt-in. /contextus-setup asks
    // and writes this per-project. Manual on-demand runs: /mine-transcripts.
    "enabled": false,
    "intervalHours": 24 // Min hours between SessionStart-triggered scans when enabled
  }
}
