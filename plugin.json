{
  "name": "claude-contextus",
  "version": "0.1.0",
  "description": "Context-aware memory system with automatic semantic retrieval",
  "author": "Anthony Dawson",
  "repository": "github:yourusername/claude-contextus",
  "license": "MIT",
  "engines": {
    "claude": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "config": {
    "enabled": true,
    "sources": {
      "projectMemory": {
        "type": "memory",
        "scope": "project",
        "path": ".claude/memory",
        "enabled": true,
        "indexFile": "MEMORY.md",
        "exclude": ["**/MEMORY.md", "**/README.md"]
      },
      "projectDocs": {
        "type": "doc",
        "scope": "project",
        "path": "docs",
        "enabled": true,
        "indexFile": "DOCS.md",
        "exclude": ["**/DOCS.md", "**/README.md"]
      },
      "userMemory": {
        "type": "memory",
        "scope": "user",
        "path": "~/.claude/memory",
        "enabled": true,
        "indexFile": "MEMORY.md",
        "exclude": ["**/MEMORY.md", "**/README.md"]
      },
      "userDocs": {
        "type": "doc",
        "scope": "user",
        "path": "~/.claude/docs",
        "enabled": true,
        "indexFile": "DOCS.md",
        "exclude": ["**/DOCS.md", "**/README.md"]
      }
    },
    "chroma": {
      "mode": "file",
      "path": "~/.claude/contextus/data/{project-name}"
    },
    "embedding": {
      "model": "Xenova/all-MiniLM-L6-v2",
      "batchSize": 32
    },
    "retrieval": {
      "topK": 5,
      "similarityThreshold": 0.7,
      "maxTokens": 3000,
      "mergeStrategy": "interleaved"
    },
    "autoRebuild": true,
    "memoryCapture": {
      "enabled": true,
      "mode": "propose"
    }
  },
  "hooks": "hooks/hooks.json",
  "skills": [
    "skills/configure",
    "skills/create-memory",
    "skills/create-doc",
    "skills/update-memory",
    "skills/add-patterns",
    "skills/rebuild-embeddings",
    "skills/search-memory",
    "skills/debug-memory",
    "skills/audit-memory",
    "skills/audit-stale"
  ]
}
