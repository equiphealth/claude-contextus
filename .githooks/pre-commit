#!/bin/sh
# Pre-commit hook: check formatting on staged TS files.
# Install: git config core.hooksPath .githooks

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|json|jsonc)$')
if [ -z "$STAGED" ]; then
  exit 0
fi

npx prettier --check $STAGED
if [ $? -ne 0 ]; then
  echo ""
  echo "✗ Prettier check failed. Run: pnpm format"
  echo ""
  exit 1
fi
