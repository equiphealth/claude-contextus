# Dependencies
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Model cache (large, downloaded on demand)
.cache/
*.onnx
*.onnx_data

# Build outputs
#   dist/ IS committed (packaging decision, see docs/dev/PACKAGING.md) so a
#   marketplace clone runs `node dist/...` with no build step. Ship runtime .js
#   only — the type-decl + sourcemap artifacts churn every build and aren't needed
#   at runtime.
dist/**/*.d.ts
dist/**/*.d.ts.map
dist/**/*.js.map
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log

# Temp files
tmp/
temp/
*.tmp

# Example outputs (for development)
examples/test-output/

# Presentation materials (local prep, not tracked)
docs/presentation/
