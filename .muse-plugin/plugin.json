{
  "capabilities": {
    "commands": [],
    "hooks": [
      {
        "command": ["node", "adapter/muse-code/session-start.js"],
        "event": "SessionStart",
        "id": "contextus-session-start",
        "statusMessage": "Contextus: warming daemon",
        "timeoutMs": 15000
      },
      {
        "command": ["node", "adapter/muse-code/query.js"],
        "event": "UserPromptSubmit",
        "id": "contextus-query",
        "statusMessage": "Contextus: retrieving context",
        "timeoutMs": 10000
      },
      {
        "command": ["node", "adapter/muse-code/watch.js"],
