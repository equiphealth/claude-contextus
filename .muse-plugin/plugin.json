        "id": "contextus-watch",
        "statusMessage": "Contextus: tracking context edits",
        "timeoutMs": 5000
      },
      {
        "command": ["node", "adapter/muse-code/stop.js"],
        "event": "Stop",
        "id": "contextus-stop",
        "statusMessage": "Contextus: logging usage",
        "timeoutMs": 5000
      }
    ],
